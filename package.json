{
  "name": "degen-base-nft-bridge",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/relayer.js",
    "relay": "node src/relayer.js",
    "preflight": "node scripts/preflight.mjs",
    "addresses": "node scripts/show-addresses.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:controlled:1155": "node scripts/controlled-test-1155.mjs",
    "test": "node --test test/*.test.js",
    "build:viem": "esbuild src/browserViem.js --bundle --format=esm --platform=browser --target=es2020 --outfile=docs/vendor/viem.js --minify",
    "build:miniapp": "esbuild src/browserMiniApp.js --bundle --format=esm --platform=browser --target=es2020 --outfile=docs/vendor/farcaster-miniapp.js --minify",
    "build:frontend": "npm run build:viem && npm run build:miniapp",
    "build": "npm run build:frontend && forge build"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@farcaster/miniapp-sdk": "0.3.0",
    "dotenv": "^17.4.2",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.62.1"
  }
}
