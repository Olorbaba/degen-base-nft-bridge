# Production source chain. Keep relaying disabled until all deployment checks pass.
SOURCE_RPC_URL=https://rpc.degen.tips
SOURCE_CHAIN_ID=666666666
SOURCE_CHAIN_NAME="Degen Chain"
SOURCE_CURRENCY_SYMBOL=DEGEN
ALLOW_DEGEN_MAINNET=false
ALLOW_HYBRID_BRIDGE=false
RELAY_ENABLED=false
SOURCE_VAULT_ADDRESS=0x22A3a63eB8276928Cb5D45f5e67533BCa7D859A6
SOURCE_START_BLOCK=26961814
SOURCE_CONFIRMATIONS=5

# Destination (Base) mainnet chain.
BASE_RPC_URL=https://mainnet.base.org
# Optional comma-separated failover endpoints. The relayer rotates on 429/timeouts.
BASE_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com,https://base.llamarpc.com
BASE_CHAIN_ID=8453
BASE_MIRROR_ADDRESS=0xE08e1ae0e27300882CfF35534cfd5804BFa87697
DEPLOYER_PRIVATE_KEY=0x
RELAYER_PRIVATE_KEY=0x
RELAYER_ADDRESS=
MIRROR_OWNER=
DESTINATION_CONFIRMATIONS=5

# Relayer service
POLL_INTERVAL_MS=15000
STATE_FILE=./relayer-state.json
PORT=8787
LOG_LEVEL=info
CORS_ORIGIN=*
PUBLIC_APP_URL=
