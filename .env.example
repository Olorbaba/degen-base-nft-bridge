# Source chain. The public evaluation route uses Ethereum Sepolia.
SOURCE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SOURCE_CHAIN_ID=11155111
SOURCE_CHAIN_NAME=Ethereum Sepolia
SOURCE_CURRENCY_SYMBOL=ETH
ALLOW_DEGEN_MAINNET=false
ALLOW_HYBRID_BRIDGE=false
RELAY_ENABLED=true
SOURCE_VAULT_ADDRESS=
SOURCE_START_BLOCK=0
SOURCE_CONFIRMATIONS=1

# Destination (Base) chain. Use Base Sepolia for testnet.
BASE_RPC_URL=https://base-sepolia-rpc.publicnode.com
# Optional comma-separated failover endpoints. The relayer rotates on 429/timeouts.
BASE_RPC_URLS=https://base-sepolia-rpc.publicnode.com,https://base-sepolia.drpc.org,https://sepolia.base.org
BASE_CHAIN_ID=84532
BASE_MIRROR_ADDRESS=
DEPLOYER_PRIVATE_KEY=0x
RELAYER_PRIVATE_KEY=0x
RELAYER_ADDRESS=
MIRROR_OWNER=
DESTINATION_CONFIRMATIONS=1

# Relayer service
POLL_INTERVAL_MS=15000
STATE_FILE=./relayer-state.json
PORT=8787
LOG_LEVEL=info
CORS_ORIGIN=*
PUBLIC_APP_URL=
